# Copy this file to .env and fill in your PostgreSQL connection string.
# Local example:
# DATABASE_URL=postgres://tgtv:tgtv_dev_password@localhost:5432/tgtv_tournament

# Remote managed PostgreSQL services often require SSL.
# If your service requires SSL, set PGSSL=true.
# PGSSL=true

PORT=3000
DATABASE_URL=

# Optional independent processes, one database with schemas (docs/service-separation.md).
# npm run db:migrate, npm run db:provision-services, npm run start:services
# Use separate random hexadecimal passwords of at least 24 characters.
ACCOUNTS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
TOURNAMENTS_DB_PASSWORD=
STUDIO_DB_PASSWORD=
FAQ_DB_PASSWORD=
# Backend ports default to 3021..3025 and 3027. Override e.g. ACCOUNTS_PORT=3041.
# Gateway uses PORT locally; Docker Compose uses GATEWAY_PORT (default 3000).
# SERVICE_NAME=studio (container or single service; defaults to monolith)
# DB_POOL_SIZE=5

# Public production origin used for canonical URLs, robots.txt, and sitemap.xml.
# Leave empty locally.
# SITE_URL=https://ktcompanion.ru

# Canonical origin for the home page and all seven service paths.
# Production: https://ktcompanion.ru
# Local: leave empty, or use http://127.0.0.1:3000 (same port as PORT).
# Routes: /tournament, /initiative, /tracker, /studio, /dice, /faq, /combat. No subdomains required.
# COMPANION_ORIGIN=https://ktcompanion.ru

# The host port docker-compose publishes Postgres on.
# Change this if 5432 is already taken on your machine.
DB_PORT=5432

# Postgres password, used by docker-compose.
DB_PASSWORD=

# Database for the integration tests. Create it manually:
#   docker compose exec postgres createdb -U tgtv tgtv_tournament_test
TEST_DATABASE_URL=

# In production, set NODE_ENV=production (update_tgtv-ts.sh does this when
# starting the app under pm2) so the session cookie defaults to carrying the
# Secure flag -- including the cookie used for the admin password reset flow,
# which returns a plaintext temporary password over that same channel.
# COOKIE_SECURE always overrides the NODE_ENV-based default when set:
#   COOKIE_SECURE=true   forces the Secure flag on (any HTTPS deployment)
#   COOKIE_SECURE=false  forces it off (local HTTP development)
# Leave it empty to just follow NODE_ENV.
COOKIE_SECURE=

# Set to true ONLY when this app is deployed behind exactly one trusted
# reverse proxy (see update_tgtv-ts.sh) that sets X-Forwarded-For itself.
# Enables the login/register/reset-password rate limiter to key on the real
# client address instead of the proxy's own address. Leave unset/false for a
# bare Node http server with no proxy in front -- turning this on without a
# real proxy lets a client spoof its rate-limit key via that header.
# TRUST_PROXY=true


# Account email: disabled (default), local (loopback capture), resend.
# Setup and delivery behavior: docs/email-service.md
EMAIL_PROVIDER=disabled
# Required when email is enabled; 32 random bytes encoded as 64 hex characters.
EMAIL_OUTBOX_KEY=
# SITE_URL=https://ktcompanion.ru (required when email is enabled)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=KT Companion <account@auth.ktcompanion.ru>
# Optional existing inbox for replies.
EMAIL_REPLY_TO=

# Optional official PDF snapshot for /combat/library/<team>.pdf.
# Directory containing pdfs/team-rules; the bundled catalogue works without it.
# COMBAT_REFERENCE_DIR=/path/to/Warhammer-Community/2026-09-25

# Tournament System Telegram bot. Disabled until configured. See docs/telegram-bot.md.
# Start with polling; no incoming public webhook is required in this mode.
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
# Bot username without @; must match the token's bot.
TELEGRAM_BOT_USERNAME=
# Set only AFTER /miniapp is deployed on the public HTTPS site.
# Enables the bot menu and buttons that open tournament/match/profile screens.
# TELEGRAM_MINI_APP_URL=https://ktcompanion.ru/miniapp
# Webhook mode only: random 32-256 characters from A-Z, a-z, 0-9, _ and -.
TELEGRAM_WEBHOOK_SECRET=
# SITE_URL=https://ktcompanion.ru is required when the bot is enabled.
