# Copy this file to .env and fill in your PostgreSQL connection string.
# Local example:
# DATABASE_URL=postgres://tgtv:tgtv_dev_password@localhost:5432/tgtv_tournament

# Remote managed PostgreSQL services often require SSL.
# If your service requires SSL, set PGSSL=true.
# PGSSL=true

PORT=3000
DATABASE_URL=

# Public production origin used for canonical URLs, robots.txt, and sitemap.xml.
# Leave empty locally.
# SITE_URL=https://rating.ktcompanion.ru

# The host port docker-compose publishes Postgres on.
# Change this if 5432 is already taken on your machine.
DB_PORT=5432

# Postgres password, used by docker-compose.
DB_PASSWORD=

# Database for the integration tests. Create it manually:
#   docker compose exec postgres createdb -U tgtv tgtv_tournament_test
TEST_DATABASE_URL=

# In production, set NODE_ENV=production (update_tgtv-ts.sh does this when
# starting the app under pm2) so the session cookie defaults to carrying the
# Secure flag -- including the cookie used for the admin password reset flow,
# which returns a plaintext temporary password over that same channel.
# COOKIE_SECURE always overrides the NODE_ENV-based default when set:
#   COOKIE_SECURE=true   forces the Secure flag on (any HTTPS deployment)
#   COOKIE_SECURE=false  forces it off (local HTTP development)
# Leave it empty to just follow NODE_ENV.
COOKIE_SECURE=

# Set to true ONLY when this app is deployed behind exactly one trusted
# reverse proxy (see update_tgtv-ts.sh) that sets X-Forwarded-For itself.
# Enables the login/register/reset-password rate limiter to key on the real
# client address instead of the proxy's own address. Leave unset/false for a
# bare Node http server with no proxy in front -- turning this on without a
# real proxy lets a client spoof its rate-limit key via that header.
# TRUST_PROXY=true
