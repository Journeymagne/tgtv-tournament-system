[Unit]
Description=Keep current KT Companion release and two successful predecessors
After=pm2-root.service

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM2_HOME=/root/.pm2
ExecStart=/usr/bin/flock -n -E 75 /app/tgtv-ts.update.lock /usr/bin/env TGTV_DEPLOY_LOCKED=/app/tgtv-ts /usr/bin/node /app/tgtv-ts-shared/bin/prune-releases.js /app/tgtv-ts --apply
SuccessExitStatus=75
Nice=10
IOSchedulingClass=idle

