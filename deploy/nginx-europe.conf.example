# European edge. Install after obtaining a certificate for both names.
# The origin uses its existing ktcompanion.ru certificate; preserve verification.
server {
    listen 80;
    server_name killteamcompanion.com www.killteamcompanion.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://killteamcompanion.com$request_uri; }
}

server {
    listen 443 ssl;
    server_name www.killteamcompanion.com;
    ssl_certificate /etc/letsencrypt/live/killteamcompanion.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/killteamcompanion.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://killteamcompanion.com$request_uri;
}

server {
    listen 443 ssl;
    server_name killteamcompanion.com;
    ssl_certificate /etc/letsencrypt/live/killteamcompanion.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/killteamcompanion.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;

    location / {
        proxy_pass https://193.19.118.183;
        proxy_ssl_server_name on;
        proxy_ssl_name ktcompanion.ru;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host killteamcompanion.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host killteamcompanion.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Authenticated HTML and API responses must never share a proxy cache.
        proxy_cache off;
    }
}
