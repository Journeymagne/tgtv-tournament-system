# Install only after DNS and a certificate covering all five names are ready.
# App .env: COMPANION_ORIGIN=https://ktcompanion.ru
#           SITE_URL=https://rating.ktcompanion.ru
#           NODE_ENV=production
#           TRUST_PROXY=true  (exactly one trusted proxy)
# Adjust certificate paths and the app port to match the deployment.
server {
    listen 80;
    server_name ktcompanion.ru initiative.ktcompanion.ru tracker.ktcompanion.ru
                rating.ktcompanion.ru studio.ktcompanion.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ktcompanion.ru initiative.ktcompanion.ru tracker.ktcompanion.ru
                rating.ktcompanion.ru studio.ktcompanion.ru;
    ssl_certificate /etc/letsencrypt/live/ktcompanion.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ktcompanion.ru/privkey.pem;

    # Studio projects can include image albums; Node enforces per-route limits.
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        # Let Node select the entry page. Do not use try_files /index.html here.
    }
}
