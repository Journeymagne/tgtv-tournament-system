{
  "name": "tgtv-ranking-tournament-system",
  "version": "1.4.16",
  "private": true,
  "description": "TGTV ranking, matchmaking, Approved Ops, and Kill Team challenge tracker.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "start:service": "node scripts/start-service.js",
    "start:services": "node scripts/start-services.js",
    "db:migrate": "node scripts/migrate.js",
    "db:provision-services": "node scripts/provision-service-roles.js",
    "telegram:setup": "node scripts/setup-telegram.js",
    "verify:migration:canonical-games": "node scripts/verify-canonical-games-migration.js",
    "test": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "build:combat": "node scripts/build-combat-lab.js",
    "postinstall": "node scripts/prepare-combat-lab.js"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "pg": "^8.22.0"
  }
}
