{
  "name": "kt-companion-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/sync-tokens.cjs",
    "export": "expo export --platform all",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "build:ios": "npx eas-cli build --platform ios --profile preview",
    "test:api": "node --import tsx --test tests/api.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
